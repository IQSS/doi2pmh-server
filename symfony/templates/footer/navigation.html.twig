<div class="col-lg-12">
    <nav class="navbar navbar-light navbar-expand-lg">
        <div class="container-fluid">
            <ul class="navbar-nav me-auto d-flex justify-content-center align-items-center flex-wrap mb-0">
                {% for entry in navigation_menu.getFooterLinks %}
                    <li class="nav-item {{ entry.class }}">
                        {% if entry.type == "link" %}
                            <a href="{{ entry.url }}" title="{{ entry.name | trans }}" class="nav-link" target="_blank">
                                {{ entry.name | trans }}
                            </a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </nav>
</div>
